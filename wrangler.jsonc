{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tianwei-io-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // Smart placement may move the Worker next to Neon (us-east-1); in practice
  // the callers already sit there, so it runs where requests arrive (README).
  "placement": { "mode": "smart" },

  "observability": {
    "enabled": true
  },

  // Non-secret configuration. DATABASE_URL is a secret:
  //   pnpm wrangler secret put DATABASE_URL
  "vars": {
    "NODE_ENV": "production",
    "ALLOWED_ORIGINS": ""
  },

  // Custom domain (enabled at cutover 2026-07-07; Cloudflare manages the
  // DNS record + certificate). NOTE: a deploy from a config WITHOUT this
  // block would detach the domain; do not remove.
  "routes": [{ "pattern": "tio.twz.app", "custom_domain": true }],

  // workers.dev and version preview URLs stay off: tio.twz.app is the only
  // entry point. Stated explicitly because workers_dev would default back to
  // true if `routes` were ever emptied.
  "workers_dev": false,
  "preview_urls": false
}
