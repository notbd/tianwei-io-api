# ============================================================
# Local development bindings for `wrangler dev`
# ============================================================
# Copy this file to .dev.vars and fill in the values.
# .dev.vars is gitignored; never commit real credentials.
#
# Note: the neon-http driver speaks Neon's HTTP proxy protocol.
# The content engine's `pnpm dev` serves it for its local
# database on 127.0.0.1:5431; any other DATABASE_URL must be a
# Neon branch, not a plain Postgres.
# ============================================================

NODE_ENV=development

# The content engine's local database (run `pnpm dev` there first).
# For a Neon branch: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://local@127.0.0.1:5431/local

# Optional: enables /api/__preview/post/:slug (draft preview for the
# frontend's draftMode). Min 16 chars. Production: `wrangler secret put PREVIEW_SECRET`
# PREVIEW_SECRET=
